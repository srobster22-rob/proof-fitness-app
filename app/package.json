{
  "name": "proof",
  "version": "0.1.0",
  "private": true,
  "description": "PROOF — a lifting log whose fastest path to recording a set also produces a clip worth posting.",
  "//type": "NOT \"module\". Metro, babel and the Expo config loader are all CommonJS; with type:module Node refuses to load metro.config.js as ESM on Windows and the bundle dies. Node still runs the .ts sources and tests correctly — it detects the ESM syntax and reparses, which costs a warning and nothing else.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "bundle": "expo export --platform ios --no-bytecode --output-dir ./.export",
    "build": "node build-domain.cjs",
    "test": "node check-deps.cjs && node build-domain.cjs && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tools/failure-log.mjs --test-reporter-destination=stdout \"test/**/*.test.ts\" && tsc --noEmit",
    "e2e": "node tools/render-recap.ts",
    "typecheck": "tsc --noEmit",
    "check-deps": "node check-deps.cjs",
    "web": "node tools/seed-web.ts && expo start --web --port 8099",
    "seed": "node tools/seed-web.ts",
    "cards": "node tools/card-sheet.cjs"
  },
  "dependencies": {
    "@expo/cli": "54.0.26",
    "@expo/metro-config": "54.0.17",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@react-native/virtualized-lists": "0.81.5",
    "babel-preset-expo": "54.0.12",
    "expo": "~54.0.0",
    "expo-asset": "12.0.13",
    "expo-constants": "18.0.13",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.23",
    "expo-font": "14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "15.0.8",
    "expo-localization": "17.0.9",
    "expo-modules-core": "3.0.30",
    "expo-router": "~6.0.24",
    "expo-sharing": "14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "~19.1.0",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.13.0",
    "typescript": "~5.9.2"
  }
}
